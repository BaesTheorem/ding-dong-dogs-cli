#!/bin/sh
# Entry point. Prefers the repo's own venv (uv venv && uv pip install -e .), then any
# python3 that can import curl_cffi.
here="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$here/.venv/bin/python" ]; then
  exec "$here/.venv/bin/python" -m dddcli "$@"
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dddcli "$@"
